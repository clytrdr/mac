# --- Homebrew Environment ---
# Sets PATH, HOMEBREW_PREFIX, and adds Homebrew's Zsh completions to fpath.
# fpath must be set before `compinit` is called.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Leave casks with `auto_updates true` to their own updaters.
# Homebrew 6 upgrades such casks by default when the app bundle version is
# older than the tap version. For apps that ship often, this re-downloads
# hundreds of MB on every `brew upgrade`.
export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1

# --- Path for n ---
export N_PREFIX="$HOME/.n"
export PATH="$N_PREFIX/bin:$PATH"

# --- Path for user-local binaries ---
# Used by installers such as the Antigravity CLI.
export PATH="$HOME/.local/bin:$PATH"

# --- Default Editor ---
export EDITOR=vim
export VISUAL=vim

# --- Plugin Manager (zinit) ---
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ -f "${ZINIT_HOME}/zinit.zsh" ]]; then
  source "${ZINIT_HOME}/zinit.zsh"
fi

# --- Useful Options (setopt) ---
setopt AUTO_CD              # cd to a directory just by typing its name
setopt EXTENDED_GLOB        # Extended globbing. Also required by the compinit cache check below.
setopt NOTIFY               # Notify on completion of long-running jobs

# --- Completion System Setup ---
# Initialize the completion system
autoload -Uz compinit
# Speed up compinit by using a cache file
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
  # compinit keeps the old dump when nothing changed. Touch it so the
  # 24-hour check above does not run the full compinit on every start.
  touch "${ZDOTDIR:-$HOME}/.zcompdump"
else
  compinit -C
fi

# --- fzf Integration ---
# fzf (fuzzy finder) is installed via Homebrew.
# Its completion script must be sourced after compinit.
if [[ -f "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/fzf/shell/completion.zsh" ]]; then
  source "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/fzf/shell/completion.zsh"
fi
if [[ -f "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/fzf/shell/key-bindings.zsh" ]]; then
  source "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/fzf/shell/key-bindings.zsh"
fi

# --- Git Prompt Setup ---
# git-prompt.sh is managed by Ansible
if [[ -f ~/.zsh/git-prompt.sh ]]; then
  source ~/.zsh/git-prompt.sh
fi
# Define an empty fallback so the prompt does not print an error when
# git-prompt.sh is missing.
(( $+functions[__git_ps1] )) || __git_ps1() { :; }

# Configure the information shown in the git prompt
GIT_PS1_SHOWDIRTYSTATE=true
GIT_PS1_SHOWUNTRACKEDFILES=true
GIT_PS1_SHOWSTASHSTATE=true
GIT_PS1_SHOWUPSTREAM=auto

# --- Prompt Configuration ---
# Enable command substitution in the prompt
setopt PROMPT_SUBST
# Clear the right prompt
RPROMPT=''
# Set the main prompt (PS1): user@host: current_directory $ git_status
PS1='%F{green}%n@%m%f: %F{cyan}%~%f \$ %F{red}$(__git_ps1 "(%s)")%f '

# --- History Configuration ---
HISTFILE=~/.zsh_history      # History file path
HISTSIZE=10000               # Number of lines to keep in memory
SAVEHIST=10000               # Number of lines to save in the history file
setopt HIST_EXPIRE_DUPS_FIRST   # Expire duplicates first when trimming history
setopt HIST_IGNORE_DUPS         # Don't record an event if it's a duplicate of the previous one
setopt HIST_FIND_NO_DUPS        # When searching, find the newest entry without duplicates
setopt HIST_IGNORE_SPACE        # Don't save commands that start with a space
setopt SHARE_HISTORY            # Share history between all sessions

# --- Aliases ---
# Common aliases for convenience
alias ls='ls -G'            # Enable colors for ls on macOS
alias la='ls -A'

# Claude Code launchers with a fixed model and reasoning effort
alias fable='claude --model fable --effort high'
alias fablemedium='claude --model fable --effort medium'
alias opushigh='claude --model opus --effort high'
alias opusmedium='claude --model opus --effort medium'
alias opuslow='claude --model opus --effort low'

# Codex CLI launchers with a fixed model and reasoning effort
alias astrahigh='codex -m gpt-6-astra -c model_reasoning_effort=high'
alias astramedium='codex -m gpt-6-astra -c model_reasoning_effort=medium'
alias solhigh='codex -m gpt-6-sol -c model_reasoning_effort=high'
alias solmedium='codex -m gpt-6-sol -c model_reasoning_effort=medium'

# Antigravity CLI launchers with a fixed model and reasoning effort
alias flashhigh='agy --model gemini-3.8-flash --effort high'
alias prohigh='agy --model gemini-3.1-pro --effort high'

# --- Custom Functions ---
# A function to update all package managers at once.
# It skips a tool if its command is not found.
# It prints the failed steps at the end and returns 1 if any step fails.
updateall() {
  local -a failed

  # Usage: _updateall_step <label> <command> [args...]
  # The 'failed' array is visible here because zsh uses dynamic scope.
  _updateall_step() {
    local label=$1
    shift
    if ! command -v $1 &> /dev/null; then
      print "\nINFO: $1 not found. Skipping."
      return
    fi
    print "\n==> $label"
    "$@" || failed+=("$label")
  }

  _updateall_step "Updating Homebrew metadata..." brew update
  # The '--yes' flag skips the upgrade confirmation prompt.
  _updateall_step "Upgrading Homebrew packages..." brew upgrade --yes
  # The '-y' flag automatically confirms the update.
  _updateall_step "Updating all Conda packages..." conda update --all -y
  # Update Node.js before npm so that global packages use the new version.
  _updateall_step "Updating Node.js to the latest LTS..." n lts
  # This also updates Codex CLI, because it is a global npm package.
  _updateall_step "Updating global npm packages..." npm update -g --no-fund
  _updateall_step "Updating pipx packages..." pipx upgrade-all
  _updateall_step "Updating Google Cloud components..." gcloud components update --quiet
  _updateall_step "Updating Claude Code..." claude update
  _updateall_step "Updating the Antigravity CLI..." agy update

  unfunction _updateall_step

  if (( $#failed )); then
    print "\n❌ Failed steps: ${(j:, :)failed}"
    return 1
  fi
  print "\n✅ All updates finished."
}

# --- Load Recommended Plugins ---
# Loaded at the end of .zshrc, as zsh-syntax-highlighting requires.
if (( $+functions[zinit] )); then
  # Suggests commands as you type based on history
  zinit light zsh-users/zsh-autosuggestions
  # Syntax highlighting for commands (must be loaded last)
  zinit light zsh-users/zsh-syntax-highlighting
fi
