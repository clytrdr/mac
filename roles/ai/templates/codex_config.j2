# ~/.codex/config.toml — Managed by Ansible (roles/ai)
# Reference: https://developers.openai.com/codex/config-basic
{% set codex_home = ansible_facts.env.HOME ~ '/.codex' %}
{% set app = ai_codex_app_path %}
{% set app_version = ai_codex_app_version_result.stdout | default('') %}
{% set cua_app = codex_home ~ '/computer-use/Codex Computer Use.app' %}
{% set cua_client = 'Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient' %}
model = {{ ai_codex_model | to_json }}
model_reasoning_effort = {{ ai_codex_reasoning_effort | to_json }}
plan_mode_reasoning_effort = {{ ai_codex_plan_mode_reasoning_effort | to_json }}
{% if app_version %}

notify = [{{ (codex_home ~ '/computer-use/' ~ cua_client) | to_json }}, "turn-ended"]
{% endif %}
{% for path in ai_codex_trusted_projects %}

[projects."{{ path }}"]
trust_level = "trusted"
{% endfor %}
{% for server in ai_mcp_servers %}
{% set codex_server = server.codex | default(server) %}
{% set codex_env = codex_server.env | default(server.env | default({})) %}

[mcp_servers.{{ server.name }}]
{% if codex_server.url is defined %}
url = {{ codex_server.url | to_json }}
{% else %}
command = {{ codex_server.command | to_json }}
args = {{ codex_server.args | to_json }}
{% endif %}
{% if codex_env %}

[mcp_servers.{{ server.name }}.env]
{% for k, v in codex_env.items() %}
{{ k }} = {{ v | to_json }}
{% endfor %}
{% endif %}
{% for tool, opts in (server.codex_tools | default({})).items() %}

[mcp_servers.{{ server.name }}.tools.{{ tool }}]
{% for k, v in opts.items() %}
{{ k }} = {{ v | to_json }}
{% endfor %}
{% endfor %}
{% endfor %}
{% if app_version %}

{# The ChatGPT app writes the blocks below itself. #}
[mcp_servers.node_repl]
args = []
command = "{{ app }}/Contents/Resources/cua_node/bin/node_repl"
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = "{{ app }}/Contents/Resources/cua_node/lib/node_modules"
NODE_REPL_NODE_PATH = "{{ app }}/Contents/Resources/cua_node/bin/node"
NODE_REPL_TRUSTED_CODE_PATHS = "{{ codex_home }}:{{ app }}/Contents/Resources/cua_node/lib/node_modules"
CODEX_HOME = "{{ codex_home }}"
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab"
BROWSER_USE_TINYSKY_ENABLED = "1"
NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_COMPUTER_USE = ""
BROWSER_USE_CODEX_APP_BUILD_FLAVOR = "prod"
BROWSER_USE_CODEX_APP_VERSION = "{{ app_version }}"
NODE_REPL_TRUSTED_SERVICES = '{"browser":"{{ codex_home }}/plugins/cache/openai-bundled/browser/{{ app_version }}/scripts/browser-service.mjs","sky":"@oai/sky/service"}'
SKY_CUA_SERVICE_PATH = "{{ cua_app }}"
CODEX_CLI_PATH = "{{ app }}/Contents/Resources/codex"

[mcp_servers.computer-use]
command = "./{{ cua_client }}"
args = ["mcp"]
cwd = "."
enabled = false
{% endif %}

{# Codex CLI writes the tui blocks itself. They are templated so the run stays idempotent. #}
[tui]
screen_reader_detection_done = true

[tui.model_availability_nux]
{{ ai_codex_model }} = {{ ai_codex_model_nux_count }}
{% if app_version %}

[desktop]
followUpQueueMode = "steer"
conversationDetailMode = "STEPS_COMMANDS"
ambient-suggestions-enabled = true
{% for marketplace in ai_codex_app_marketplaces %}

[marketplaces.{{ marketplace.name }}]
source_type = "local"
source = {{ marketplace.source | to_json }}
{% endfor %}
{% for plugin in ai_codex_app_plugins %}

[plugins."{{ plugin }}"]
enabled = true
{% endfor %}
{% endif %}
